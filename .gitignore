# Create a comprehensive .gitignore
cat > .gitignore << 'EOF'
# Environment
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Dependencies
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output

# Build
dist/
build/
*.exe
*.out

# Database
*.db
*.sqlite
*.sqlite3

# Keys
*.pem
*.key
*.crt
*.cer

# Temp
tmp/
temp/

# OS generated
Thumbs.db
ehthumbs.db
Desktop.ini
EOF